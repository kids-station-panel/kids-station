rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcının rolünü users koleksiyonundan al
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Rol kontrolleri
    function isAdmin()   { return request.auth != null && role() == 'admin'; }
    function isManager() { return request.auth != null && role() in ['admin', 'manager']; }
    function isTeacher() { return request.auth != null && role() in ['admin', 'manager', 'teacher']; }
    function isLoggedIn(){ return request.auth != null; }

    // ── Kullanıcı hesapları ─────────────────────────────────
    // Herkes kendi kaydını okuyabilir; sadece admin yazabilir
    match /users/{uid} {
      allow read: if isLoggedIn();
      // Admin her şeyi yapabilir
      allow create, delete: if isAdmin();
      // Kullanıcı kendi kaydını güncelleyebilir (lastLogin vb.)
      // ama rol/durum alanlarını değiştiremez — sadece admin yapabilir
      allow update: if isAdmin()
        || (isLoggedIn()
            && (request.auth.uid == uid || request.auth.token.email == resource.data.email)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'status', 'password']));
    }
    // Eski koleksiyon adları (migration uyumluluğu)
    match /kullanicilar/{uid} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Üyeler (veliler ve çocuklar) ───────────────────────
    // Öğretmenler okur ve yazar (yeni kayıt, düzenleme, grup ataması)
    match /members/{doc} {
      allow read, write: if isTeacher();
    }

    // ── Yoklama ────────────────────────────────────────────
    // Öğretmenler okur ve yazar
    match /attendance/{doc} {
      allow read, write: if isTeacher();
    }

    // ── Gruplar ────────────────────────────────────────────
    // Öğretmenler okur ve yazar (grup yönetimi için)
    match /groups/{doc} {
      allow read, write: if isTeacher();
    }

    // ── Personel ───────────────────────────────────────────
    // Öğretmenler okuyabilir; yazma manager+
    match /staff/{doc} {
      allow read: if isTeacher();
      allow write: if isManager();
    }

    // ── Finans — sadece manager+ ───────────────────────────
    match /finance/{doc} {
      allow read, write: if isManager();
    }
    match /finans_ayarlar/{doc} {
      allow read, write: if isManager();
    }

    // ── Duyurular ──────────────────────────────────────────
    match /announcements/{doc} {
      allow read: if isLoggedIn();
      allow write: if isManager();
    }

    // ── Program / Takvim ───────────────────────────────────
    match /schedule/{doc} {
      allow read: if isLoggedIn();
      allow write: if isTeacher();
    }

    // ── Kanallar ve mesajlar ───────────────────────────────
    match /channels/{doc} {
      allow read: if isLoggedIn();
      allow write: if isManager();
    }
    match /channelMessages/{doc} {
      allow read: if isLoggedIn();
      allow write: if isTeacher();
    }

    // ── Branşlar ───────────────────────────────────────────
    match /branches/{doc} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Raporlar ───────────────────────────────────────────
    match /reports/{doc} {
      allow read, write: if isManager();
    }

    // ── Audit log ──────────────────────────────────────────
    // Sistem yazar, sadece admin okur
    match /auditLog/{doc} {
      allow read: if isAdmin();
      allow create: if isLoggedIn();
      allow update, delete: if false;
    }

    // ── Kişisel bildirim tercihleri ────────────────────────
    match /dismissedNotifs/{doc} {
      allow read, write: if isLoggedIn();
    }
    match /readNotifs/{doc} {
      allow read, write: if isLoggedIn();
    }

    // ── Bağlantı yazma testi ──────────────────────────────
    match /_test/{doc} {
      allow read, write: if isLoggedIn();
    }

    // ── Mesai (çalışma saatleri) ───────────────────────────
    // Öğretmenler kendi kayıtlarını okur/yazar; manager+ tümünü okur
    match /timeEntries/{doc} {
      allow read: if isTeacher();
      allow write: if isTeacher();
    }

    // ── Deneme dersi başvuruları (public form) ─────────────
    // Anonim dahil herhangi bir auth kullanıcı create edebilir; okuma/silme manager+
    match /pendingTrials/{doc} {
      allow create: if request.auth != null;
      allow read, update, delete: if isManager();
    }

    // ── Diğer her şey: varsayılan red ─────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
